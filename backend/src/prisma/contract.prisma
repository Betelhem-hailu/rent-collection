// ==========================
// ENUMS
// ==========================
enum PaymentPeriod {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL_PAID
}

enum UrgencyStatus {
  DUE
  OVERDUE
  UPCOMING
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
}

enum RoleType {
  ADMIN
  LANDLORD
  TENANT
}

enum AuthState {
  PASSWORD
  UNINITIALIZED
  PHONE_VERIFIED
}

// ==========================
// PROPERTY TYPE
// ==========================
model PropertyType {
  id         Int        @id @default(autoincrement())
  name       String     @unique

  properties Property[]
}

// ==========================
// USER
// ==========================
model User {
  id       String    @id @default(uuid())
  name     String
  phone    String    @unique
  email    String?
  password String?
  role     RoleType
  authState AuthState @default(PASSWORD)
  createdAt DateTime @default(now())
  isActive Boolean   @default(false)
  phoneVerifiedAt DateTime?

  landlord Landlord?
  tenantActivation TenantActivation?
  tenantLeases Lease[] @relation("LeaseTenant")
  tenantCheckouts Checkout[]
  sentNotifications Notification[] @relation("NotificationSender")
  notifications Notification[] @relation("NotificationRecipient")
}

// Temporary activation state. Codes are managed by the SMS provider; only a
// hash of the short-lived password setup credential is stored here.
model TenantActivation {
  userId String @id
  user User @relation(fields:[userId], references:[id])
  challengeId String @unique
  phone String
  providerSid String?
  deliveryState String @default("PENDING")
  deliveryClaimedAt DateTime?
  deliveryAttempts Int @default(0)
  expiresAt DateTime
  windowStartedAt DateTime
  sendCount Int
  lastSentAt DateTime
  attempts Int @default(0)
  verifiedAt DateTime?
  setupTokenHash String?
  setupExpiresAt DateTime?

  @@index([deliveryState, expiresAt])
}

// Shared across server instances and restarts. Keys contain hashed IPs.
model AuthRateLimit {
  key String @id
  windowStartedAt DateTime
  count Int
}

// ==========================
// LANDLORD
// ==========================
model Landlord {
  userId          String     @id
  user            User       @relation(fields:[userId], references:[id])

  propertiesOwned Property[]
  leases Lease[]
}

// ==========================
// PROPERTY
// ==========================
model Property {
  id             String       @id @default(cuid(2))
  size           Decimal // square feet
  description      String
  rooms          Int
  location       String
  imageData      String?
  utilities      String?
  additionalUtilities String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  propertyTypeId Int
  propertyType   PropertyType @relation(fields:[propertyTypeId], references:[id])

  landlordId     String
  landlord       Landlord     @relation(fields:[landlordId], references:[userId])

  leases         Lease[]

  @@unique([id, landlordId])
}

// ==========================
// LEASE
// ==========================
model Lease {
  id             String          @id @default(uuid())
  amount         Decimal
  paymentPeriod  PaymentPeriod
  startDate      DateTime
  expireDate     DateTime
  status         LeaseStatus
  gracePeriod    Int
  terms          String          

  propertyId     String
  property       Property        @relation(fields:[propertyId, landlordId], references:[id, landlordId])

  landlordId     String
  landlord       Landlord        @relation(fields:[landlordId], references:[userId])
  tenantUserId   String
  tenant         User            @relation("LeaseTenant", fields:[tenantUserId], references:[id])

  billingPeriods BillingPeriod[]
  payments       Payment[]
  checkouts      Checkout[]
  notifications  Notification[]

  @@index([landlordId, tenantUserId])
  @@index([tenantUserId, status])
}

// ==========================
// BILLING PERIOD
// ==========================
model BillingPeriod {
  id            String              @id @default(cuid(2))
  amount        Decimal
  startPeriod   DateTime
  endPeriod     DateTime
  paymentStatus PaymentStatus
  urgencyStatus UrgencyStatus
  paidAmount    Decimal

  leaseId       String
  lease         Lease               @relation(fields:[leaseId], references:[id])

  allocations   PaymentAllocation[]
}

// ==========================
// PAYMENT
// ==========================
model Payment {
  id             String              @id @default(cuid(2))
  amount         Decimal
  transactionRef String              @unique
  paymentDate    DateTime
  paymentMethod  PaymentMethod

  leaseId        String
  lease          Lease               @relation(fields:[leaseId], references:[id])

  allocations    PaymentAllocation[]
}

// ==========================
// PAYMENT ALLOCATION
// ==========================
model PaymentAllocation {
  id              String        @id @default(cuid(2))
  amountAllocated Decimal

  paymentId       String
  payment         Payment       @relation(fields:[paymentId], references:[id])

  billingPeriodId String
  billingPeriod   BillingPeriod @relation(fields:[billingPeriodId], references:[id])
}

model Checkout {
  id String @id
  leaseId String
  lease Lease @relation(fields:[leaseId], references:[id])
  tenantUserId String
  tenant User @relation(fields:[tenantUserId], references:[id])
  amount Decimal
  currency String @default("ETB")
  status String @default("PENDING")
  checkoutUrl String?
  providerReference String?
  createdAt DateTime @default(now())
}

model Notification {
  id String @id
  leaseId String
  lease Lease @relation(fields:[leaseId], references:[id])
  senderId String
  sender User @relation("NotificationSender", fields:[senderId], references:[id])
  recipientId String
  recipient User @relation("NotificationRecipient", fields:[recipientId], references:[id])
  recipientEmail String
  subject String
  body String
  status String @default("PENDING")
  error String?
  createdAt DateTime @default(now())
  lastAttemptAt DateTime?
  sentAt DateTime?
}
