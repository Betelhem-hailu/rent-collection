# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Reuse one warm connection by default; raise this for higher database throughput.
DATABASE_POOL_SIZE=1
PORT=3001
JWT_SECRET_KEY="replace-with-a-long-random-secret"
# Explicit duration (e.g. 1h) or a number of seconds (e.g. 3600).
JWT_EXPIRATION=1h

# Optional: set both values to create an active admin when running pnpm seed.
# ADMIN_PHONE="+254700000000"
# ADMIN_PASSWORD="replace-with-a-strong-password"

# Chapa ETB checkout. Use test credentials first, then set mode=live with a live key.
CHAPA_SECRET_KEY=""
CHAPA_MODE=test
CHAPA_WEBHOOK_SECRET=""
# Public HTTPS addresses required for Chapa callbacks in a deployed environment.
APP_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:3000"
# Configure POST /api/v1/checkout/webhook in your Chapa dashboard.

# Overdue reminders are sent by landlords from the Leases screen.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
